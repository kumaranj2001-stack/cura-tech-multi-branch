# ── Guru Pharma — Firebase credentials ────────────────────────────────────
# Copy this file to `.env` and fill in your values for production builds.
# When set, these override the encoded fallback in src/config/firebaseConfig.ts
# so raw keys never live in source control.
#
# NOTE: browser-shipped Firebase keys are identifiers, not secrets.
# Real security comes from Firestore Security Rules (Settings → Cloud Backend)
# and, for full lockdown, migrating login to Firebase Authentication.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── OpenRouter Multimodal LLM Key for GRN Intelligent Document Parsing (Backend Only) ───
# Keep this secret! Never prefix with VITE_ to prevent leaking into client bundle.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
